# macOS
.DS_Store

# Claude Code local settings
.claude/settings.local.json
.claude/*.tmp.*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Model artifacts / large outputs
*.pth
*.pt
*.ckpt
checkpoints/
runs/
wandb/

# ...but DO keep our trained checkpoints: they are 120-380 KB each and having
# them in the repo means a fresh clone can reproduce every figure without
# retraining.
!results/model_*.pth

# ...except the crash-recovery copies 02_train.py writes mid-run. They are
# deleted when a run finishes normally, so one only exists while training is in
# flight or after a crash - never something to commit.
results/model_*.partial.pth

# The 240 MB graph cache. Regenerate with scripts/01b_prepare_full_dataset.py
# (~6 min); data_full/labels.csv and mp_to_mb.csv next to it ARE committed.
data_full/graphs.pt

# Same idea, for ALIGNN's converted+split matbench data (Phase 2). Regenerate
# with scripts/11_prepare_alignn_data.py (seconds, not minutes).
data_full/alignn_data.pkl

# Cloned upstream repos (see README)
external/

# Downloaded GNoME discovery-database files (Phase 3) - large (100s of MB),
# fetched fresh from the public GCS bucket by scripts/13_screen_gnome.py.
gnome_data/

# Kaggle: generated kernel bundle and downloaded run artifacts. The kernel is
# rebuilt from source by kaggle/build_kernel.py, so committing it would just be
# a copy that can go stale.
kaggle/build/
kaggle/output/
kaggle/pulled/

# LaTeX build artifacts (docs/build.sh regenerates the PDF)
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc

# Same, for the presentation, plus beamer-specific ones
presentation/*.aux
presentation/*.log
presentation/*.nav
presentation/*.out
presentation/*.snm
presentation/*.toc
presentation/*.vrb
presentation/build.log

# Regenerated by presentation/make_figures.py from results/metrics_summary.csv
# every build - never hand-edited, so never worth committing a copy that could
# drift from the CSV it's derived from. The compiled PDF (which IS committed)
# already embeds their rendered output.
presentation/figures/
presentation/metrics.tex

# The published paper - not ours to redistribute. Get it from the DOI in
# README.md; the pipeline never reads it.
PINK.pdf

