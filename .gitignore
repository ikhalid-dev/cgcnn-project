# macOS
.DS_Store

# Claude Code local settings
.claude/settings.local.json
.claude/*.tmp.*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Model artifacts / large outputs
*.pth
*.pt
*.ckpt
checkpoints/
runs/
wandb/

# ...but DO keep our trained checkpoints: they are 120-380 KB each and having
# them in the repo means a fresh clone can reproduce every figure without
# retraining.
!results/cgcnn/model_*.pth

# ...except the crash-recovery copies 02_train.py writes mid-run. They are
# deleted when a run finishes normally, so one only exists while training is in
# flight or after a crash - never something to commit.
results/cgcnn/model_*.partial.pth

# The 240 MB graph cache. Regenerate with scripts/cgcnn/01b_prepare_full_dataset.py
# (~6 min); data_full/labels.csv and mp_to_mb.csv next to it ARE committed.
data_full/graphs.pt

# Same idea, for ALIGNN's converted+split matbench data (Phase 2). Regenerate
# with scripts/alignn/11_prepare_alignn_data.py (seconds, not minutes).
data_full/alignn_data.pkl

# Cloned upstream repos (see README)
external/

# Downloaded GNoME discovery-database files (Phase 3) - large (100s of MB),
# fetched fresh from the public GCS bucket by scripts/cgcnn/13_screen_gnome.py.
gnome_data/

# Kaggle: generated kernel bundle and downloaded run artifacts. The kernel is
# rebuilt from source by kaggle/build_kernel.py, so committing it would just be
# a copy that can go stale.
kaggle/build/
kaggle/output/
kaggle/pulled/

# Same idea for the ALIGNN Kaggle kernel (kaggle/build_alignn_kernel.py /
# run_alignn_kernel.py) - separate directories so pushing/fetching it never
# touches the CGCNN kernel's own build state.
kaggle/build_alignn/
kaggle/output_alignn/

# Same idea again for the joint two/three-head model's Kaggle kernel
# (kaggle/build_joint_kernel.py / run_joint_kernel.py) - own build/output
# directories for the same reason: never touch the other kernels' state.
kaggle/build_joint/
kaggle/output_joint/

# Same idea for the ALIGNN Colab-CLI runner: the uploaded bundle zip is
# rebuilt from BUNDLE by run_alignn_cli.py, and alignn_output/ is where
# downloaded status/log/results files land before being merged into results/alignn/.
colab/build/
colab/alignn_output/

# LaTeX build artifacts (docs/build.sh regenerates the PDF)
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc

# Same, for the presentation, plus beamer-specific ones
presentation/*.aux
presentation/*.log
presentation/*.nav
presentation/*.out
presentation/*.snm
presentation/*.toc
presentation/*.vrb
presentation/build.log

# Regenerated by presentation/make_figures.py from results/cgcnn/metrics_summary.csv
# every build - never hand-edited, so never worth committing a copy that could
# drift from the CSV it's derived from. The compiled PDF (which IS committed)
# already embeds their rendered output.
presentation/figures/
presentation/metrics.tex

# ALIGNN results (Phase 2): keep the actual deliverable, drop what's either
# huge cache or redundant with it. best_model.pt is the one exception to the
# blanket *.pt rule above - the CGCNN checkpoints' same "fresh clone
# reproduces every figure without retraining" reasoning applies, just at
# ALIGNN's larger (~15 MB vs. 120-380 KB) scale. current_model.pt/
# last_model.pt duplicate best_model.pt's job at a worse checkpoint, and
# current_state.pt is optimizer/scheduler state only needed mid-training -
# both already caught by the *.pt rule above, no exception needed.
!results/alignn/alignn_*/best_model.pt
# The LMDB line-graph caches: ~400 MB per target, rebuilt automatically by
# scripts/alignn/12_train_alignn.py's own get_train_val_loaders() call.
results/alignn/alignn_*/train_data/
results/alignn/alignn_*/val_data/
results/alignn/alignn_*/test_data/
results/alignn/alignn_*/*_data_range

# The published paper - not ours to redistribute. Get it from the DOI in
# README.md; the pipeline never reads it.
PINK.pdf

# 45_screen_gnome_baseline_tree.py's full pre-threshold table. Every one of its
# 33,118 rows and columns is already in results/cgcnn/39_gnome_screen_all_gamma.csv
# (which that script annotates in place with the same baseline columns) - only the
# sort order differs, so this is 14 MB of exact duplication. Regenerate with
# scripts/cgcnn/45_screen_gnome_baseline_tree.py (~3 min). The candidate and oxide
# tables next to it ARE committed: those are the actual deliverable, and the
# threshold that defines them is the script's, not 39's.
results/cgcnn/45_gnome_screen_all_baseline.csv

# predict.py's default output location: one-off real-world predictions from
# whatever CIFs someone hands it, not part of the reproducible pipeline -
# same reasoning PREDICT_NEW_CIFS.txt already gives for my_cifs/my_predictions/.
predictions/

